# Environment — Cogna Backend
# Copy this to .env and fill in values

# App
APP_NAME=Cogna
APP_ENV=development
APP_URL=http://localhost:3000
PORT=4000

# Database (SQLite / Turso)
# For local development:
DATABASE_URL=file:./dev.db
DATABASE_TEST_URL=file:./test.db

# For Turso Cloud / Production:
TURSO_DATABASE_URL=libsql://your-db-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this-very-long-string
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-very-long-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin
ADMIN_EMAIL=admin@cogna.store
ADMIN_PASSWORD=password123

# Payment Gateways
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
MONNIFY_API_KEY=MK_TEST_xxxxxxxxxxxx
MONNIFY_SECRET_KEY=your-monnify-secret
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CONTRACT_CODE=your-contract-code

# Provider fallback (actual keys stored in DB providers table)
AKUNDING_API_KEY=
AKUNDING_BASE_URL=https://akunding.shop/api/v1

# Queue
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@cogna.store
